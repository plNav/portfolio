---
import { TAGS } from "../constants/Tags.js";
import Tag from "./Tag.astro";
const MOBILE_SKILLS = [
    TAGS.FLUTTER,
    TAGS.DART,
    TAGS.KOTLIN,
    TAGS.COMPOSE,
    TAGS.SWIFTUI,
    TAGS.SWIFT,
    TAGS.FIREBASE,
];
const ARCHITECTURE_SKILLS = [
    TAGS.CLEANARCH,
    TAGS.MVVM,
    TAGS.NODE,
    TAGS.TYPESCRIPT,
    TAGS.SPRING,
    TAGS.EXPRESS,
    TAGS.MYSQL,
    TAGS.MONGODB,
];
const DEVOPS_SKILLS = [
    TAGS.DOCKER,
    TAGS.GITHUBACTIONS,
    TAGS.AZUREDEVOPS,
    TAGS.CICD,
    TAGS.LINUX,
    TAGS.GIT,
    TAGS.GITHUB,
];
const LEADERSHIP_SKILLS = [
    TAGS.LEADERSHIP,
    TAGS.MENTORING,
    TAGS.CLIENTCOMM,
    TAGS.OWNERSHIP,
    TAGS.PROBLEMRES,
    TAGS.TEAMWORK,
];
---

<div class="text-white">
    <h3 class="text-xl font-semibold my-2 pt-6">Mobile</h3>
    <ul class="flex gap-x-4 flex-row flex-wrap">
        {
            MOBILE_SKILLS.map((skill) => (
                <Tag name={skill.name}>
                    <skill.icon class="size-5 text-white" />
                </Tag>
            ))
        }
    </ul>
    <h3 class="text-xl font-semibold my-2 pt-12">Architecture & Backend</h3>
    <ul class="flex gap-x-4 flex-row flex-wrap">
        {
            ARCHITECTURE_SKILLS.map((skill) => (
                <Tag name={skill.name}>
                    <skill.icon class="size-5" />
                </Tag>
            ))
        }
    </ul>
    <h3 class="text-xl font-semibold my-2 pt-12">DevOps & Delivery</h3>
    <ul class="flex gap-x-4 flex-row flex-wrap">
        {
            DEVOPS_SKILLS.map((skill) => (
                <Tag name={skill.name}>
                    <skill.icon class="size-5" />
                </Tag>
            ))
        }
    </ul>
    <h3 class="text-xl font-semibold my-2 pt-12">Leadership</h3>
    <ul class="flex gap-x-4 flex-row flex-wrap">
        {
            LEADERSHIP_SKILLS.map((skill) => (
                <Tag name={skill.name}>
                    <skill.icon class="size-5" />
                </Tag>
            ))
        }
    </ul>
</div>
