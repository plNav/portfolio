---
import { TAGS } from "../constants/Tags.js";
import Tag from "./Tag.astro";
const PROJECTS = [
    {
        title: "Hexblem - Board Game",
        description: `Demo mobile board game published on iOS and Android, built with Flutter using the BloC pattern,
            local persistence, shaders, and platform channels. Automated distribution runs through GitHub Actions CI/CD,
            running unit and end-to-end integration tests as part of the deployment flow. Clean architecture makes services
            easy to swap and inspect. Firebase and Node.js are used only for
            debug backend flows.`,
        link: null,
        stores: [
            {
                platform: "iOS",
                name: "App Store",
                action: "Download on",
                icon: "/pictures/apple-store.webp",
                href: "https://apps.apple.com/es/app/hexblem/id6740856646?l=en-GB",
            },
            {
                platform: "Android",
                name: "Google Play",
                action: "Get it on",
                icon: "/pictures/google-play.webp",
                href: "https://play.google.com/store/apps/details?id=com.unbeatablegames.hexblem&pcampaignid=web_share",
            },
        ],
        github: null,
        image: "/projects/hexblem.webp",
        tags: [TAGS.FLUTTER, TAGS.SWIFT, TAGS.KOTLIN, TAGS.FIREBASE, TAGS.NODE],
    },
    {
        title: "Baccus - POS for Hotel CRM",
        description: `Production POS and CRM ecosystem for hotels, built for Android and Windows with Flutter, Java,
            Spring, Hibernate, MySQL, microservices, and platform-specific integrations.`,
        link: null,
        github: null,
        image: "/projects/baccus.webp",
        tags: [TAGS.FLUTTER, TAGS.JAVA, TAGS.SPRING, TAGS.LINUX, TAGS.MYSQL],
    },
    {
        title: "Illustrashop - Sales App",
        description: `Sales application built with Kotlin Multiplatform, Node.js, MongoDB Atlas, card payment gateways,
             PayPal, and Google Pay integrations.`,
        link: null,
        github: null,
        image: "/projects/illustrashop.webp",
        tags: [TAGS.KOTLIN, TAGS.COMPOSE, TAGS.MONGODB, TAGS.JAVA],
    },
];
---

<style>
    .project-card {
        background-color: #2a2a2a; /* Dark background */
        color: #ffffff; /* White text */
        border-radius: 12px; /* Rounded corners */
        padding: 16px; /* Padding for content */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3); /* Shadow for depth */
        transition: transform 0.2s; /* Smooth hover effect */
    }

    .project-card:hover {
        transform: scale(1.05); /* Slightly enlarge on hover */
    }

    .project-link {
        color: #cc8e35; /* Bright blue for links */
        text-decoration: underline; /* No underline */
        font-weight: bold; /* Bold text */
    }

    .project-link:hover {
        text-decoration: underline; /* Underline on hover */
    }

    .store-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin: 18px 0 4px;
    }

    .store-preview {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 10px;
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        text-decoration: none;
        transition:
            transform 0.2s,
            border-color 0.2s,
            background-color 0.2s;
    }

    .store-preview:hover,
    .store-preview:focus-visible {
        transform: translateY(-2px);
        border-color: rgba(204, 142, 53, 0.8);
        background: rgba(204, 142, 53, 0.14);
        outline: none;
    }

    .store-icon {
        display: inline-flex;
        width: 44px;
        height: 44px;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.12);
    }

    .store-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .store-copy {
        min-width: 0;
        flex: 1;
    }

    .store-action {
        display: block;
        color: rgba(255, 255, 255, 0.62);
        font-size: 0.75rem;
        line-height: 1;
        margin-bottom: 4px;
    }

    .store-name {
        display: block;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .store-arrow {
        color: rgba(255, 255, 255, 0.55);
        font-size: 1.25rem;
        line-height: 1;
    }

    .project-image {
        border-radius: 12px; /* Rounded corners for image */
        margin-top: 16px; /* Space between text and image */
        width: 100%; /* Full width image */
    }
</style>

{
    PROJECTS.map(({ title, description, tags, image, link, stores }) => (
        <article class="project-card pb-10 mt-6 mb-4">
            <h3 class="text-2xl font-semibold mb-2 mt-2">{title}</h3>
            <p class="text-lg mb-4 text-pretty opacity-80">{description}</p>
            <ul class="flex gap-x-2 flex-wrap">
                {tags.map((tag) => (
                    <Tag name={tag.name}>{<tag.icon class="size-5" />}</Tag>
                ))}
            </ul>
            {link && (
                <p class="text-lg mb-4">
                    <a href={link} target="_blank" class="project-link">
                        Visit it
                    </a>
                </p>
            )}
            {stores && (
                <div class="store-grid" aria-label={`${title} store links`}>
                    {stores.map((store) => (
                        <a
                            href={store.href}
                            target="_blank"
                            rel="noopener"
                            class="store-preview"
                        >
                            <span class="store-icon">
                                <img src={store.icon} alt={`${store.platform} icon`} loading="lazy" />
                            </span>
                            <span class="store-copy">
                                <span class="store-action">{store.action}</span>
                                <span class="store-name">{store.name}</span>
                            </span>
                            <span class="store-arrow" aria-hidden="true">→</span>
                        </a>
                    ))}
                </div>
            )}
            <img
                class="project-image rounded shadow-2xl shadow-white/10"
                src={image}
                alt={`Screenshot of the ${title} project`}
            />
        </article>
    ))
}
