---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import Mail from "../icons/Mail.astro";
import SocialPill from "../components/SocialPill.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Briefcase from "../icons/Briefcase.astro";
import Code from "../icons/Code.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import SkillsIcon from "../icons/SkillsIcon.astro";
import ProjectsIcon from "../icons/ProjectsIcon.astro";
import Copy from "../icons/Copy.astro";
---

<Layout
	title="Pablo L Portfolio. Senior Mobile Engineer."
	description="Senior Mobile Engineer focused on Flutter, Kotlin, Firebase, DevOps, CI/CD, and team leadership."
>
	<main class="px-8">
		<SectionContainer id="top" class="pt-28 pb-[4.5rem] md:pt-32 md:pb-[5.5rem]">
			<img
				class="rounded-full size-40 mb-8 mx-auto"
				src="/pictures/pablopic.webp"
				alt="pablo l navarro photo"
			/>
			<h1
				class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-col sm:flex-row justify-center items-center gap-4 pb-6 lg:pb-10 text-center"
			>
				Hi! I'm Pablo
				<a
					href="https://www.linkedin.com/in/pablo-l-navarro-6b20a5292"
					target="_blank"
					rel="noopener"
					class="flex justify-center items-center"
				>
					<Badge>Open to Work </Badge>
				</a>
			</h1>
			<h2 class="text-xl md:text-2xl lg:text-3xl text-wrap max-w-[700px] text-center mx-auto font-bold">
				<span class="text-white opacity-80">Senior Mobile </span>
				<span class="text-red-100/80">Engineer</span>
			</h2>
			<h2 class="lg:text-xl text-white max-w-[700px] text-pretty text-justify mt-6 mx-auto">
				<span class="opacity-80"
					>I build and modernize production mobile applications with
					<span class="text-red-100/80">Flutter</span>,
					<span class="text-red-100/80">Kotlin</span>, Jetpack Compose,
					SwiftUI, and Firebase. With <span class="text-yellow-100/75"
						>6+ years of professional experience</span
					>, I focus on scalable mobile architecture, reliable backend
					integrations, <span class="text-red-100/80">CI/CD and DevOps workflows</span>,
					and helping teams deliver maintainable products.
				</span>
			</h2>

			<nav class="flex gap-4 mt-10 flex-wrap justify-center">
				<SocialPill
					href=`https://www.linkedin.com/in/pablo-l-navarro-6b20a5292`
				>
					<LinkedIn class="size-4 lg:size-6" />
					LinkedIn
				</SocialPill>

				<SocialPill href="https://github.com/plNav">
					<GitHub class="size-4 lg:size-6" />
					GitHub
				</SocialPill>

				<div id="mailButton">
					<SocialPill href="#">
						<Mail class="size-4 lg:size-6" />
						pablo93bio@gmail.com
					</SocialPill>
				</div>
				<div
					id="copyButton"
					class="rounded-full border border-white/10 flex justify-center items-center gap-x-2
					py-1 px-2 lg:py-2 lg:px-4 text-xs lg:text-base bg-white/5 hover:scale-110 hover:bg-white/10 transition"
				>
					<Copy class="size-4 lg:size-6 text-white" />
					<Mail class="size-4 lg:size-6 text-white" />
				</div>
			</nav>
		</SectionContainer>
	</main>

	<SectionContainer id="experience">
		<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
			<Briefcase class="size-7" />
			Experience
		</h2>
		<Experience />
	</SectionContainer>

	<SectionContainer id="skills">
		<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
			<SkillsIcon class="size-7" />
			Skills
		</h2>
		<Skills />
	</SectionContainer>

	<SectionContainer id="projects">
		<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
			<Code class="size-7" />
			Projects
		</h2>
		<Projects />
	</SectionContainer>
</Layout>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const mailButton = document.getElementById("mailButton");
		const copyButton = document.getElementById("copyButton");

		if (mailButton) {
			mailButton.addEventListener("click", () => {
				const subject = encodeURIComponent("Portfolio Contact");
				const email = "pablo93bio@gmail.com";
				window.location.href = `mailto:${email}?subject=${subject}`;
			});
		}

		if (copyButton) {
			copyButton.addEventListener("click", () => {
				navigator.clipboard
					.writeText("pablo93bio@gmail.com")
					.then(() => {
						alert(
							"Email copied to clipboard\n pablo93bio@gmail.com",
						);
					})
					.catch((err) => {
						console.error("Error copying email: ", err);
					});
			});
		}
	});
</script>
